{
  "name": "saucedemo-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (TypeScript) UI and API test automation practice project",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0"
  }
}
